meta {
  name: Admin Change User Password
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/account/user?account_id=e9b4ca51-81cd-4f8b-86c2-4fc5d2e0750c
  body: json
  auth: inherit
}

params:query {
  account_id: e9b4ca51-81cd-4f8b-86c2-4fc5d2e0750c
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "new_password": "{{userPassword}}1"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
