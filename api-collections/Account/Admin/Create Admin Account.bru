meta {
  name: Create Admin Account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/account/admin
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "email": "{{adminEmail}}1",
    "password": "{{adminPassword}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
