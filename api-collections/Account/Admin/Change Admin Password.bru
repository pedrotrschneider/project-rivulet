meta {
  name: Change Admin Password
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/v1/account/admin
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "new_password": "{{adminPassword}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
