meta {
  name: Create First Admin Account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/account/admin/first
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
