meta {
  name: User Logout
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{userAccessToken}}
}

body:json {
  {
    "refresh_token": "{{userRefreshToken}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
