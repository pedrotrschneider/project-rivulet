meta {
  name: User Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  let data = res.getBody();
  bru.setVar("userAccessToken", data.access_token);
  bru.setVar("userRefreshToken", data.refresh_token);
}

settings {
  encodeUrl: true
  timeout: 0
}
