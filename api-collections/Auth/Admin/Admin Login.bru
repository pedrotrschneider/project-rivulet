meta {
  name: Admin Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  let data = res.getBody();
  bru.setVar("adminAccessToken", data.access_token);
  bru.setVar("adminRefreshToken", data.refresh_token);
}

settings {
  encodeUrl: true
  timeout: 0
}
