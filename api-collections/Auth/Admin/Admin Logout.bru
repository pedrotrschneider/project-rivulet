meta {
  name: Admin Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "refresh_token": "{{adminRefreshToken}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
