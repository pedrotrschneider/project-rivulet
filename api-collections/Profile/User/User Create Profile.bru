meta {
  name: User Create Profile
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/profile
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{userAccessToken}}
}

body:json {
  {
    "name": "Yuki",
    "avatar": "https://cool-avatar.com"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
