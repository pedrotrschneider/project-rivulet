meta {
  name: User Install Addon
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/addon
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{userAccessToken}}
}

body:json {
  {
    "manifest_url": "https://mycooladdon.com/manifest.json",
    "priority": 10
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
